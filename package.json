  },
  "devDependencies": {
    "@prisma/orm-family-sql": "^8.0.0-rc.19",
    "@prisma/orm-framework": "^8.0.0-rc.19",
    "@sentry/node": "^11.8.0",
    "@types/node": "^26.6.5",
    "prisma": "^8.0.0-rc.19",
    "rimraf": "^6.0.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
