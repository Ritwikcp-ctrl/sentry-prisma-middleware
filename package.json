  "license": "ISC",
  "type": "module",
  "main": "./dist/sentry-middleware.js",
  "types": "./dist/sentry-middleware.d.ts",
  
  "files": [
    "dist",
    "README.md"
  ],

  "keywords": [
    "prisma",
    "prisma-orm-extension",
    "prisma-orm",
    "sentry",
    "middleware",
    "observability",
    "tracing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ritwikcp-ctrl/sentry-prisma-middleware.git"
  },
  
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "npm run clean && tsc",
